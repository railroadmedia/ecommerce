{
  "name": "railroad/ecommerce",
  "type": "library",
  "description": "Ecommerce system",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "guzzlehttp/guzzle": "^7.2",
    "doctrine/dbal": "^3.3",
    "doctrine/inflector": "^2.0",
    "doctrine/annotations": "^2.0",
    "doctrine/orm": "^2.19",
    "ramsey/uuid": "^4.3",
    "railroad/location": "4.0.*",
    "railroad/permissions": "3.0.*",
    "railroad/remotestorage": "3.0.*",
    "railroad/doctrine": "3.0.*",
    "railroad/doctrine-array-hydrator": "3.0.*",
    "ext-redis": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "aporat/store-receipt-validator": "4.2.*",
    "stripe/stripe-php": "^7.95",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "psr-4": {
      "Railroad\\Ecommerce\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\Ecommerce\\Tests\\": "tests/",
      "Railroad\\Ecommerce\\Seeds\\": "seeds/"
    }
  }
}
